# Nuxt
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Express
# The API does not load this file automatically. The process must receive these variables.
# NODE_ENV is required: development, test, or production.
NODE_ENV=development
# Optional. Defaults to 3001.
PORT=3001
# Optional in development and test. Defaults to http://localhost:3000.
# Required in production: HTTPS, and not a local host.
WEB_ORIGIN=http://localhost:3000
# Optional in development and test. Required in production.
# Test accepts only a local host. Production rejects local hosts and postgres/postgres.
# Local Supabase example. The API uses this for one pg pool.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional pool settings. Defaults: 10 connections, 5000 ms connect, 10000 ms idle.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# Optional in development and test. Required in production: HTTPS, and not a local host.
# Public JWKS is read from this origin. The API does not use a JWT shared secret.
SUPABASE_URL=http://127.0.0.1:54321
# Optional public key. Not read by the API yet. It may be used by Nuxt for Auth.
SUPABASE_ANON_KEY=
# Optional server secret. Not required until Storage or Auth admin API is used.
# Never place this value in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Payments and email — reserved for later server features.
# The API configuration does not read them yet.

# Payments — server only
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_CRC_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email — server only
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Never commit real .env files.
