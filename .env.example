# Nuxt
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Express
# The API does not load this file automatically. The process must receive these variables.
# NODE_ENV is required: development, test, or production.
NODE_ENV=development
# Optional. Defaults to 3001.
PORT=3001
# Optional in development and test. Defaults to http://localhost:3000.
# Required in production: HTTPS, and not a local host.
# The Nuxt server reads this same variable as the allowed browser origin for
# POST /api/v1/auth/csrf. It is not NUXT_PUBLIC and is not the API origin.
# NUXT_BFF_ALLOWED_ORIGIN overrides it for the Nuxt process only.
WEB_ORIGIN=http://localhost:3000
# Optional in development and test. Required in production.
# Test accepts only a local host. Production rejects local hosts and postgres/postgres.
# Local Supabase example. The API uses this for one pg pool.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional pool settings. Defaults: 10 connections, 5000 ms connect, 10000 ms idle.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# Optional in development and test. Required in production: HTTPS, and not a local host.
# Public JWKS is read from this origin. The API does not use a JWT shared secret.
SUPABASE_URL=http://127.0.0.1:54321
# Optional public key. Not read by the API yet. It may be used by Nuxt for Auth.
SUPABASE_ANON_KEY=
# Optional server secret. Not required until Storage or Auth admin API is used.
# Never place this value in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional until account login is implemented. When set, it must be 32 bytes
# encoded as standard base64. Generate one locally and do not commit it:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# The API does not accept this value from Nuxt public config.
SESSION_TOKEN_KEY=
# Optional until the account rate limiter is called. When set, it must be 32 bytes
# encoded as standard base64. Generate one locally and do not commit it:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# This is not SESSION_TOKEN_KEY and it does not enter Nuxt public config.
RATE_LIMIT_HMAC_KEY=
# Optional until an internal Nuxt call is made. When set, it must be 32 bytes
# encoded as standard base64. Generate one locally and do not commit it:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# The same value belongs in the Nuxt server env as NUXT_BFF_INTERNAL_SECRET.
# It must not use the NUXT_PUBLIC_ prefix.
BFF_INTERNAL_SECRET=
# Optional. Exact IP addresses of the Nuxt process, separated by commas.
# Empty means every internal call is rejected. No wildcards, CIDR, or host names.
# Local processes on this machine use 127.0.0.1,::1
BFF_TRUSTED_PEERS=

# Przelewy24 — server only. Leave all of these empty until the adapter is configured.
# If any identity variable is set, all of them are required.
# P24_ENVIRONMENT is sandbox or production.
# development and test accept only sandbox. production accepts only production.
# The API base URL is chosen from that environment and cannot be overridden.
# P24_POS_ID is the Basic Auth user. P24_API_SECRET is the report key (secretId).
# P24_CRC_KEY is used only for SHA-384 signatures. It is a different secret.
# Optional timeout in milliseconds. Default 10000. Range 1000–60000.
# P24_URL_RETURN and P24_URL_STATUS are public callback URLs, not secrets.
# Sandbox online checkout needs both. Production online checkout stays disabled.
P24_ENVIRONMENT=
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=
P24_API_SECRET=
P24_REQUEST_TIMEOUT_MS=
P24_URL_RETURN=
P24_URL_STATUS=

# Email — server only
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Never commit real .env files.
